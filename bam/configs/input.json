{
    "cutoff" : 6.0,
    "train_path": "/path/to/train_pkl_dir_or_traj",
    "valid_path": "/path/to/valid_pkl_dir_or_traj",
    "atom_energies_path": "/path/to/atom_energies.json",
    "loss_type": "mae",
    "hidden_irreps": "640x0e + 320x1o + 128x2e + 128x3o",
    "lmax": 3,
    "n_layers": 5,
    "radial_basis_size": 8,
    "radial_mlp_size": 64,
    "radial_mlp_layers": 3,
    "radial_polynomial_p": 5.0,
    "mlp_init_scale": 4.0,
    "learning_rate": 0.01,
    "lr_schedule_patience": 25,
    "lr_schedule_factor": 0.8,
    "lr_schedule_min_scale": 0.01,
    "batch_size": 20,
    "n_epochs": 100,
    "energy_weight": 100.0,
    "force_weight": 1.0,
    "stress_weight": 1.0,
    "huber_delta": 0.02,
    "log_every": 100,
    "ema_decay": 0.99,
    "grad_clip": 1.0,
    "restart": false,

    "predict": {
        "evaluate_tag": false,
        "model": "ckpt_best.pkl",
        "test_path": "/path/to/test.traj"
    }
}
