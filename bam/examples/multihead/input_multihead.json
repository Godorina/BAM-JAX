{
    "foundation_ckpt": "ckpt_foundation.pkl",

    "lmax": 3,
    "hidden_irreps": "640x0e + 320x1o + 128x2e + 128x3o",
    "n_layers": 5,
    "radial_basis_size": 8,
    "radial_mlp_size": 64,
    "radial_mlp_layers": 3,
    "radial_polynomial_p": 5.0,
    "mlp_init_scale": 4.0,

    "learning_rate": 0.0005,
    "batch_size": 4,
    "n_epochs": 100,
    "energy_weight": 1.0,
    "force_weight": 100.0,
    "stress_weight": 1.0,
    "loss_type": "huber",
    "huber_delta": 0.02,
    "ema_decay": 0.99,
    "use_checkpoint": true,
    "max_nodes_per_batch": 512,

    "lr_schedule_patience": 10,
    "lr_schedule_factor": 0.5,
    "lr_schedule_min_scale": 0.01,

    "log_every": 10,
    "seed": 42,
    "restart": false,
    "fname_log": "loss_multihead.out",

    "heads": [
        {
            "name": "replay_omat24",
            "head_idx": 0,
            "train_traj": "/path/to/omat24_train.traj",
            "valid_traj": "/path/to/omat24_valid.traj",
            "train_path": "data/omat24_train_pkl",
            "valid_path": "data/omat24_valid_pkl",
            "grad_weight": 0.3,
            "energy_weight": 1.0,
            "force_weight": 1.0,
            "stress_weight": 1.0
        },
        {
            "name": "target_lpsc",
            "head_idx": 1,
            "train_traj": "/path/to/target_train.traj",
            "valid_traj": "/path/to/target_valid.traj",
            "train_path": "data/lpsc_train_pkl",
            "valid_path": "data/lpsc_valid_pkl",
            "grad_weight": 1.0,
            "energy_weight": 1.0,
            "force_weight": 100.0,
            "stress_weight": 1.0
        }
    ]
}
